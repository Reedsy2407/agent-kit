{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git rev-list:*)",
      "Bash(git rev-parse:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git switch:*)",
      "Bash(git merge --squash:*)",
      "Bash(git pull --ff-only:*)",
      "Bash(git push:*)",
      "Bash(node --test:*)",
      "Bash(node .claude/hooks/premerge-check.mjs:*)",
      "Bash(node .claude/hooks/escaneo-secretos.mjs:*)",
      "Bash(timeout * node --test:*)",
      "Bash(timeout * node .claude/hooks/premerge-check.mjs:*)",
      "Bash(node install/install.mjs --auto:*)",
      "Bash(timeout * node install/install.mjs --auto:*)"
    ],
    "deny": [
      "Bash(git rebase:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push * --force-with-lease*)",
      "Bash(curl * -X *)",
      "Bash(curl * --request*)",
      "Bash(curl * -d *)",
      "Bash(curl * --data*)",
      "Bash(curl * -F *)",
      "Bash(curl * --form*)",
      "Bash(curl * -T *)",
      "Bash(curl * --upload-file*)",
      "Bash(docker system prune:*)",
      "Bash(docker volume rm:*)",
      "Bash(docker volume prune:*)",
      "Bash(rm * ..*)",
      "Bash(gh auth token:*)",
      "Bash(gh secret:*)",
      "Bash(gh repo delete:*)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-shell.mjs"
            ],
            "timeout": 30
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-commit.mjs"
            ],
            "timeout": 30
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-merge.mjs"
            ],
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-write.mjs"
            ],
            "timeout": 30
          }
        ]
      }
    ]
  }
}
