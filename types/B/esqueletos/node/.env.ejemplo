# Solo nombres de variables, sin valores. Copia este archivo a .env (git lo ignora) y rellena los valores en tu máquina.
# Obligatoria: el servicio no arranca sin ella (desarrollo o produccion).
APP_ENTORNO=
# Opcionales: PORT (por defecto 8080) y HOST (por defecto 127.0.0.1; en contenedor 0.0.0.0).
PORT=
HOST=
